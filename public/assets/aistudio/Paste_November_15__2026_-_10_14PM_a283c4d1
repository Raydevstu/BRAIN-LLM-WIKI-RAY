"use client";
import { useEffect, useState } from "react";
import { ReactFlow, Background, Controls, MiniMap, type Node, type Edge } from "@xyflow/react";
import "@xyflow/react/dist/style.css";
import { api, type GraphData } from "@/lib/api";

const COLORS: Record<string, string> = {
  concept: "#6366f1", entity: "#10b981", summary: "#f59e0b",
  doctrine: "#ef4444", idea: "#ec4899", note: "#64748b", raw: "#475569",
};

export default function GraphView({ centerId, onSelect }: { centerId: string | null; onSelect: (id: string) => void }) {
  const [nodes, setNodes] = useState<Node[]>([]);
  const [edges, setEdges] = useState<Edge[]>([]);

  useEffect(() => {
    let live = true;
    api.ego(centerId).then((g: GraphData) => {
      if (!live) return;
      const byHop = new Map<number, string[]>();
      for (const n of g.nodes) {
        const h = n.hop ?? 0;
        byHop.set(h, [...(byHop.get(h) ?? []), n.id]);
      }
      const pos = new Map<string, { x: number; y: number }>();
      byHop.forEach((ids, hop) => {
        const r = hop * 280;
        ids.forEach((id, i) => {
          const a = (2 * Math.PI * i) / ids.length;
          pos.set(id, hop === 0 ? { x: 0, y: 0 } : { x: r * Math.cos(a), y: r * Math.sin(a) });
        });
      });
      setNodes(g.nodes.map((n) => ({
        id: n.id,
        position: pos.get(n.id) ?? { x: 0, y: 0 },
        data: { label: n.title },
        style: {
          background: COLORS[n.type] ?? "#64748b", color: "#fff",
          border: n.hop === 0 ? "2px solid #e2e8f0" : "1px solid #1e293b",
          borderRadius: 8, width: 170, fontSize: 12, padding: 8,
        },
      })));
      setEdges(g.edges.map((e, i) => ({
        id: `e${i}`, source: e.source, target: e.target,
        style: { stroke: "#475569" },
      })));
    });
    return () => { live = false; };
  }, [centerId]);

  if (nodes.length === 0) return <div style={{ padding: 24 }}>Loading graph… (is the API running and synced?)</div>;

  return (
    <ReactFlow nodes={nodes} edges={edges} fitView minZoom={0.1}
               onNodeClick={(_, n) => onSelect(n.id)}>
      <Background color="#1e293b" />
      <Controls />
      <MiniMap pannable zoomable nodeColor={(n) => (n.style?.background as string) ?? "#64748b"} />
    </ReactFlow>
  );
}
