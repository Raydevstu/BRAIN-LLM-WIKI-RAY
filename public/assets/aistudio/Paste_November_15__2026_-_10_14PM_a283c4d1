export const API = process.env.NEXT_PUBLIC_API_BASE ?? "http://localhost:8000";

export type NodeLite = { id: string; title: string; type: string; path: string; hop: number };
export type GraphData = { nodes: NodeLite[]; edges: { source: string; target: string; kind: string }[] };
export type SearchResult = { id: string; title: string; type: string; path: string; score: number; snippet: string; via: string };
export type Neighbor = { id: string; title: string; type: string; kind: string; dir: string };
export type NodeDetail = { id: string; title: string; type: string; path: string; props: Record<string, unknown>; chunks: string[]; neighbors: Neighbor[] };

async function get<T>(path: string): Promise<T> {
  const r = await fetch(API + path);
  if (!r.ok) throw new Error(await r.text());
  return r.json() as Promise<T>;
}

export const api = {
  search: (q: string) => get<SearchResult[]>(`/search?q=${encodeURIComponent(q)}&limit=10`),
  ego: (id: string | null) => get<GraphData>(id ? `/graph/ego?node_id=${id}&hops=2` : `/graph/ego?hops=2`),
  node: (id: string) => get<NodeDetail>(`/nodes/${id}`),
};
