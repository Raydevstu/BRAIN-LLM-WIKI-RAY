"use client";
import { useState, type FormEvent } from "react";
import GraphView from "@/components/GraphView";
import { api, type SearchResult, type NodeDetail } from "@/lib/api";

export default function Page() {
  const [q, setQ] = useState("");
  const [results, setResults] = useState<SearchResult[]>([]);
  const [centerId, setCenterId] = useState<string | null>(null);
  const [detail, setDetail] = useState<NodeDetail | null>(null);

  const select = async (id: string) => {
    setCenterId(id);
    setDetail(await api.node(id));
  };

  const submit = async (e: FormEvent) => {
    e.preventDefault();
    if (!q.trim()) return;
    const rs = await api.search(q.trim());
    setResults(rs);
    if (rs.length) await select(rs[0].id);
  };

  return (
    <main className="layout">
      <aside className="sidebar">
        <h1>CortexOS</h1>
        <form onSubmit={submit}>
          <input value={q} onChange={(e) => setQ(e.target.value)} placeholder="Search your knowledge…" />
        </form>
        {results.map((r) => (
          <button key={r.id} className="result" onClick={() => select(r.id)}>
            <span className={`badge ${r.type}`}>{r.type}</span>
            <strong>{r.title}</strong>
            <small>{r.via} · {r.snippet.slice(0, 140)}</small>
          </button>
        ))}
        {detail && (
          <div className="detail">
            <h2>{detail.title}</h2>
            <p className="path">{detail.path}</p>
            <h3>Relations ({detail.neighbors.length})</h3>
            {detail.neighbors.map((n) => (
              <button key={n.id + n.dir + n.kind} className="result" onClick={() => select(n.id)}>
                <span className={`badge ${n.type}`}>{n.type}</span>
                {n.title}
                <small>{n.dir === "out" ? "→" : "←"} {n.kind}</small>
              </button>
            ))}
          </div>
        )}
      </aside>
      <section className="graph">
        <GraphView key={centerId ?? "root"} centerId={centerId} onSelect={select} />
      </section>
    </main>
  );
}
