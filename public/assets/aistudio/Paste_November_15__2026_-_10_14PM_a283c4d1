**backend/cortex/schema.sql** — `__DIM__` is substituted at migrate time.
```sql
create extension if not exists vector;

create table if not exists nodes (
  id uuid primary key default gen_random_uuid(),
  path text unique not null,
  type text not null,
  title text not null,
  props jsonb not null default '{}',
  content_hash text not null,
  updated_at timestamptz,
  synced_at timestamptz not null default now(),
  search tsvector generated always as (
    to_tsvector('english', title || ' ' || coalesce(props->>'aliases', ''))
  ) stored
);
create index if not exists nodes_search_idx on nodes using gin (search);
create index if not exists nodes_type_idx on nodes (type);

create table if not exists edges (
  src uuid not null references nodes(id) on delete cascade,
  dst uuid not null references nodes(id) on delete cascade,
  kind text not null default 'REFERENCES',
  primary key (src, dst, kind)
);
create index if not exists edges_dst_idx on edges (dst);

create table if not exists chunks (
  id bigserial primary key,
  node_id uuid not null references nodes(id) on delete cascade,
  ord int not null,
  text text not null,
  embedding vector(__DIM__) not null,
  search tsvector generated always as (to_tsvector('english', text)) stored
);
create index if not exists chunks_node_idx on chunks (node_id);
create index if not exists chunks_search_idx on chunks using gin (search);
create index if not exists chunks_vec_idx on chunks using hnsw (embedding vector_cosine_ops);
