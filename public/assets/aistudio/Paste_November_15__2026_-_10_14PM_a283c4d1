## Slice 2 — Vault parser + sync engine

**backend/cortex/parser.py**
````python
import hashlib
import re
from dataclasses import dataclass
from pathlib import Path

import yaml

WIKILINK = re.compile(r"\[\[([^\]|#]+)(?:#[^\]|]*)?(?:\|[^\]]*)?\]\]")
FENCE = re.compile(r"```.*?```", re.S)
H1 = re.compile(r"^#\s+(.+)$", re.M)
H2 = re.compile(r"^##\s+", re.M)

SKIP_DIRS = {".git", ".obsidian", ".trash", "Templates", "Boards", "Inbox"}
SKIP_FILES = {"README.md", "Home.md", "CLAUDE.md"}
MAX_CHUNK = 1500

FOLDER_TYPE = {"Concepts": "concept", "Entities": "entity", "Summaries": "summary",
               "Doctrine": "doctrine", "Armory": "idea", "Raw": "raw"}


@dataclass
class ParsedNote:
    path: str
    title: str
    type: str
    props: dict
    links: list
    chunks: list
    content_hash: str
    updated: str | None


def _split_frontmatter(text):
    if text.startswith("---\n"):
        end = text.find("\n---\n", 4)
        if end != -1:
            try:
                props = yaml.safe_load(text[4:end]) or {}
                if not isinstance(props, dict):
                    props = {}
            except yaml.YAMLError:
                props = {}
            return props, text[end + 5:]
    return {}, text


def _chunk(body):
    sections = [s.strip() for s in H2.split(body) if s.strip()]
    if not sections:
        sections = [body.strip()] if body.strip() else []
    chunks = []
    for sec in sections:
        if len(sec) <= MAX_CHUNK:
            chunks.append(sec)
        else:
            buf = ""
            for para in sec.split("\n\n"):
                if buf and len(buf) + len(para) + 2 > MAX_CHUNK:
                    chunks.append(buf)
                    buf = para
                else:
                    buf = f"{buf}\n\n{para}" if buf else para
            if buf:
                chunks.append(buf)
    return chunks


def parse_vault(vault, include_raw=False):
    vault = Path(vault)
    notes = []
    for p in sorted(vault.rglob("*.md")):
        rel = p.relative_to(vault)
        parts = rel.parts
        if any(part in SKIP_DIRS for part in parts[:-1]):
            continue
        if len(parts) == 1 and parts[0] in SKIP_FILES:
            continue
        if parts[0] == "Raw" and not include_raw:
            continue
        raw = p.read_bytes()
        text = raw.decode("utf-8", errors="replace")
        props, body = _split_frontmatter(text)
        tags = props.get("tags") or []
        if isinstance(tags, str):
            tags = [tags]
        if "redirect" in tags:
            continue
        m = H1.search(body)
        title = m.group(1).strip() if m else p.stem
        ntype = props.get("type") or FOLDER_TYPE.get(parts[-2] if len(parts) > 1 else "", "note")
        updated = props.get("updated") or props.get("created")
        updated = updated.isoformat() if hasattr(updated, "isoformat") else (str(updated) if updated else None)
        clean = FENCE.sub("", body)
        links = [t.strip() for t in WIKILINK.findall(clean)]
        chunks = _chunk(body) or [title]
        notes.append(ParsedNote(
            path=rel.as_posix(), title=title, type=str(ntype), props=props,
            links=links, chunks=chunks,
            content_hash=hashlib.sha256(raw).hexdigest(), updated=updated,
        ))
    return notes


def resolve_links(notes):
    index = {}
    for n in notes:
        keys = {n.title.lower(), Path(n.path).stem.lower(), n.path.lower()}
        for a in (n.props.get("aliases") or []):
            keys.add(str(a).lower())
        for k in keys:
            index.setdefault(k, n.path)
    resolved, unresolved = {}, []
    for n in notes:
        out = []
        for target in n.links:
            key = target.split("/")[-1].strip().lower()
            tgt = index.get(key)
            if tgt is None:
                unresolved.append((n.path, target))
            elif tgt != n.path and tgt not in out:
                out.append(tgt)
        resolved[n.path] = out
    return resolved, unresolved
````

**backend/cortex/embeddings.py** — OpenAI for production; deterministic `hash` provider so the whole pipeline runs offline today.
```python
import hashlib
import math
import random
import re

from . import config

_cache = {}
_token_vecs = {}


def _hash_vector(text, dim):
    tokens = re.findall(r"\w+", text.lower())
    acc = [0.0] * dim
    for tok in tokens:
        v = _token_vecs.get(tok)
        if v is None:
            rng = random.Random(int(hashlib.sha256(tok.encode()).hexdigest()[:16], 16))
            v = [rng.uniform(-1, 1) for _ in range(dim)]
            _token_vecs[tok] = v
        for i in range(dim):
            acc[i] += v[i]
    norm = math.sqrt(sum(x * x for x in acc))
    if norm == 0:
        return [1.0 / math.sqrt(dim)] * dim
    return [x / norm for x in acc]


class Embedder:
    def __init__(self, provider=None, model=None, dim=None, api_key=None):
        self.provider = provider or config.EMBED_PROVIDER
        self.model = model or config.EMBED_MODEL
        self.dim = dim or config.EMBED_DIM
        self.api_key = api_key or config.OPENAI_API_KEY
        self._client = None

    def embed(self, texts):
        if not texts:
            return []
        if self.provider == "hash":
            return [_hash_vector(t, self.dim) for t in texts]
        if self._client is None:
            from openai import OpenAI
            self._client = OpenAI(api_key=self.api_key)
        out = []
        for i in range(0, len(texts), 64):
            batch = texts[i:i + 64]
            resp = self._client.embeddings.create(model=self.model, input=batch)
            out.extend(d.embedding for d in resp.data)
        return out


def default_embedder():
    if "e" not in _cache:
        _cache["e"] = Embedder()
    return _cache["e"]


def vec_literal(v):
    return "[" + ",".join(f"{x:.6f}" for x in v) + "]"
```

**backend/cortex/sync.py** — hash-based: unchanged files are never re-embedded (verified: second sync = 0 embedding calls).
```python
import json
import threading
import time
from pathlib import Path

from . import config
from .embeddings import Embedder, vec_literal
from .parser import parse_vault, resolve_links

UPSERT_NODE = """
insert into nodes (path, type, title, props, content_hash, updated_at)
values (%s, %s, %s, %s::jsonb, %s, %s)
on conflict (path) do update set
  type = excluded.type, title = excluded.title, props = excluded.props,
  content_hash = excluded.content_hash, updated_at = excluded.updated_at,
  synced_at = now()
returning id
"""


def sync_vault(conn, vault=None, embedder=None, include_raw=None, log=print):
    vault = Path(vault or config.VAULT_PATH)
    if not vault.is_dir():
        raise FileNotFoundError(f"Vault not found: {vault}")
    embedder = embedder or Embedder()
    include_raw = config.INCLUDE_RAW if include_raw is None else include_raw

    notes = parse_vault(vault, include_raw)
    links, unresolved = resolve_links(notes)
    existing = {r["path"]: r["content_hash"]
                for r in conn.execute("select path, content_hash from nodes").fetchall()}
    stats = {"scanned": len(notes), "changed": 0, "unchanged": 0,
             "deleted": 0, "edges": 0, "unresolved_links": len(unresolved)}

    path_to_id = {}
    for n in notes:
        changed = existing.get(n.path) != n.content_hash
        nid = conn.execute(UPSERT_NODE, (
            n.path, n.type, n.title, json.dumps(n.props, default=str),
            n.content_hash, n.updated,
        )).fetchone()["id"]
        path_to_id[n.path] = nid
        if changed:
            conn.execute("delete from chunks where node_id = %s", (nid,))
            vecs = embedder.embed([f"{n.title}\n{c}" for c in n.chunks])
            for i, (text, v) in enumerate(zip(n.chunks, vecs)):
                conn.execute(
                    "insert into chunks (node_id, ord, text, embedding) values (%s, %s, %s, %s::vector)",
                    (nid, i, text, vec_literal(v)))
            stats["changed"] += 1
        else:
            stats["unchanged"] += 1

    for n in notes:
        src = path_to_id[n.path]
        conn.execute("delete from edges where src = %s", (src,))
        for tgt in links.get(n.path, []):
            dst = path_to_id.get(tgt)
            if dst and dst != src:
                conn.execute(
                    "insert into edges (src, dst, kind) values (%s, %s, 'REFERENCES') on conflict do nothing",
                    (src, dst))
                stats["edges"] += 1

    paths = [n.path for n in notes]
    if paths:
        stats["deleted"] = conn.execute("delete from nodes where path <> all(%s)", (paths,)).rowcount
    else:
        log("WARNING: vault parsed to 0 notes; skipping prune to protect the database")
    for src_path, target in unresolved[:20]:
        log(f"unresolved link: {src_path} -> [[{target}]]")
    return stats


def watch(debounce=2.0):
    from watchdog.observers import Observer
    from watchdog.events import FileSystemEventHandler
    from .db import pool

    embedder = Embedder()
    dirty = threading.Event()

    class Handler(FileSystemEventHandler):
        def on_any_event(self, event):
            p = str(getattr(event, "src_path", ""))
            if (not event.is_directory and p.endswith(".md")
                    and "/.obsidian/" not in p and "/.git/" not in p):
                dirty.set()

    obs = Observer()
    obs.schedule(Handler(), str(config.VAULT_PATH), recursive=True)
    obs.start()
    print(f"Watching {config.VAULT_PATH} (debounce {debounce}s). Ctrl-C to stop.")
    try:
        while True:
            if dirty.wait(timeout=1.0):
                time.sleep(debounce)
                dirty.clear()
                with pool().connection() as conn:
                    print(sync_vault(conn, embedder=embedder))
    except KeyboardInterrupt:
        pass
    finally:
        obs.stop()
        obs.join()
```

