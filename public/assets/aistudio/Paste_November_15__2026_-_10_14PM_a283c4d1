## Slice 3 — Hybrid retrieval + API

Retrieval = keyword (GIN tsvector on nodes + chunks) + vector (HNSW cosine) → **RRF fusion** → **1-hop graph expansion** → **recency boost**. The three ranking stages are pure functions (unit-tested).

**backend/cortex/retrieval.py**
```python
import math
from datetime import datetime, timezone

from . import config
from .embeddings import vec_literal

KEYWORD_NODES = """
select id as node_id, ts_rank(search, plainto_tsquery('english', %(q)s)) as rank
from nodes where search @@ plainto_tsquery('english', %(q)s)
order by rank desc limit %(k)s
"""

KEYWORD_CHUNKS = """
select node_id, max(ts_rank(search, plainto_tsquery('english', %(q)s))) as rank
from chunks where search @@ plainto_tsquery('english', %(q)s)
group by node_id order by rank desc limit %(k)s
"""

VECTOR = """
select node_id, min(distance) as distance from (
  select node_id, embedding <=> %(v)s::vector as distance
  from chunks order by embedding <=> %(v)s::vector limit %(kc)s
) t group by node_id order by distance asc limit %(k)s
"""

NEIGHBORS = """
select src, dst from edges where src = any(%(ids)s) or dst = any(%(ids)s)
"""

HYDRATE = """
select n.id, n.path, n.type, n.title, n.props, n.updated_at,
  (select text from chunks c where c.node_id = n.id order by ord limit 1) as snippet
from nodes n where n.id = any(%(ids)s)
"""


def rrf_fuse(rankings, k=60):
    scores = {}
    for ranking in rankings:
        for rank, node_id in enumerate(ranking, start=1):
            scores[node_id] = scores.get(node_id, 0.0) + 1.0 / (k + rank)
    return scores


def expand_graph(scores, adjacency, factor=0.35, max_seeds=5):
    seeds = sorted(scores, key=scores.get, reverse=True)[:max_seeds]
    expanded = dict(scores)
    for s in seeds:
        for nb in adjacency.get(s, []):
            bonus = factor * scores[s]
            if expanded.get(nb, 0.0) < bonus:
                expanded[nid] = bonus if False else bonus  # noqa
    return expanded


def recency_boost(scores, ages_days, weight=0.25, half_life=30.0):
    out = {}
    for nid, score in scores.items():
        age = ages_days.get(nid)
        out[nid] = score * (1 + weight * math.exp(-age / half_life)) if age is not None else score
    return out


def _rank_ids(rows):
    return [str(r["node_id"]) for r in rows]


def hybrid_search(conn, query, limit, embedder):
    k = config.CANDIDATES
    kw_nodes = conn.execute(KEYWORD_NODES, {"q": query, "k": k}).fetchall()
    kw_chunks = conn.execute(KEYWORD_CHUNKS, {"q": query, "k": k}).fetchall()
    keyword_ids = _rank_ids(kw_nodes + kw_chunks)
    seen, kw_ranked = set(), []
    for nid in keyword_ids:
        if nid not in seen:
            seen.add(nid)
            kw_ranked.append(nid)
    qvec = vec_literal(embedder.embed([query])[0])
    vec_rows = conn.execute(VECTOR, {"v": qvec, "kc": k * 4, "k": k}).fetchall()
    vec_ranked = _rank_ids(vec_rows)

    scores = rrf_fuse([kw_ranked, vec_ranked], k=config.RRF_K)
    via = {}
    for nid in kw_ranked:
        via[nid] = "keyword"
    for nid in vec_ranked:
        via[nid] = "keyword+vector" if nid in via else "vector"
    if not scores:
        return []

    seed_ids = sorted(scores, key=scores.get, reverse=True)[:5]
    adj = {}
    for r in conn.execute(NEIGHBORS, {"ids": seed_ids}).fetchall():
        s, d = str(r["src"]), str(r["dst"])
        adj.setdefault(s, []).append(d)
        adj.setdefault(d, []).append(s)
    before = set(scores)
    scores = expand_graph(scores, adj)
    for nid in scores:
        if nid not in before:
            via[nid] = "graph"

    ids = list(scores)
    rows = conn.execute(HYDRATE, {"ids": ids}).fetchall()
    now = datetime.now(timezone.utc)
    ages = {}
    by_id = {}
    for r in rows:
        nid = str(r["id"])
        by_id[nid] = r
        ages[nid] = (now - r["updated_at"]).total_seconds() / 86400 if r["updated_at"] else None
    scores = recency_boost(scores, ages, weight=config.RECENCY_WEIGHT)

    results = []
    for nid in sorted(scores, key=scores.get, reverse=True)[:limit]:
        r = by_id.get(nid)
        if r is None:
            continue
        results.append({
            "id": nid, "title": r["title"], "type": r["type"], "path": r["path"],
            "score": round(scores[nid], 6), "via": via.get(nid, "graph"),
            "snippet": (r["snippet"] or "")[:300],
            "updated_at": r["updated_at"].isoformat() if r["updated_at"] else None,
        })
    return results


EGO = """
with recursive ego as (
  select %(center)s::uuid as id, 0 as hop
  union
  select case when e.src = ego.id then e.dst else e.src end, ego.hop + 1
  from ego join edges e on (e.src = ego.id or e.dst = ego.id)
  where ego.hop < %(hops)s
)
select distinct on (id) id, hop from ego order by id, hop
"""

EGO_EDGES = "select src, dst, kind from edges where src = any(%(ids)s) and dst = any(%(ids)s)"
EGO_NODES = "select id, path, type, title from nodes where id = any(%(ids)s)"
TOP_CENTER = """
select id from (
  select src as id from edges union all select dst as id from edges
) t group by id order by count(*) desc limit 1
"""


def pick_center(conn):
    row = conn.execute(TOP_CENTER).fetchone()
    return str(row["id"]) if row else None


def ego_graph(conn, center_id, hops=2, max_nodes=None):
    max_nodes = max_nodes or config.MAX_EGO_NODES
    hop_rows = conn.execute(EGO, {"center": center_id, "hops": hops}).fetchall()
    hop_of = {str(r["id"]): r["hop"] for r in hop_rows}
    ids = list(hop_of)
    edges = conn.execute(EGO_EDGES, {"ids": ids}).fetchall()
    degree = {}
    for e in edges:
        for nid in (str(e["src"]), str(e["dst"])):
            degree[nid] = degree.get(nid, 0) + 1
    keep = sorted(ids, key=lambda i: (hop_of[i], -degree.get(i, 0)))[:max_nodes]
    keep_set = set(keep)
    nodes = conn.execute(EGO_NODES, {"ids": keep}).fetchall()
    return {
        "nodes": [{"id": str(n["id"]), "title": n["title"], "type": n["type"],
                   "path": n["path"], "hop": hop_of[str(n["id"])]} for n in nodes],
        "edges": [{"source": str(e["src"]), "target": str(e["dst"]), "kind": e["kind"]}
                  for e in edges if str(e["src"]) in keep_set and str(e["dst"]) in keep_set],
    }


NODE_BY_ID = "select id, path, type, title, props, updated_at from nodes where id = %(id)s"
NODE_CHUNKS = "select text from chunks where node_id = %(id)s order by ord"
NODE_NEIGHBORS = """
select n.id, n.title, n.type, e.kind, 'out' as dir
from edges e join nodes n on n.id = e.dst where e.src = %(id)s
union all
select n.id, n.title, n.type, e.kind, 'in' as dir
from edges e join nodes n on n.id = e.src where e.dst = %(id)s
"""


def node_detail(conn, node_id):
    row = conn.execute(NODE_BY_ID, {"id": node_id}).fetchone()
    if row is None:
        return None
    chunks = [r["text"] for r in conn.execute(NODE_CHUNKS, {"id": node_id}).fetchall()]
    neighbors = [{"id": str(r["id"]), "title": r["title"], "type": r["type"],
                  "kind": r["kind"], "dir": r["dir"]}
                 for r in conn.execute(NODE_NEIGHBORS, {"id": node_id}).fetchall()]
    return {"id": str(row["id"]), "path": row["path"], "type": row["type"],
            "title": row["title"], "props": row["props"],
            "updated_at": row["updated_at"].isoformat() if row["updated_at"] else None,
            "chunks": chunks, "neighbors": neighbors}


CREATOR_PIPELINE = """
select title, props->>'status' as status, props->>'hook' as hook, updated_at
from nodes where type = 'idea' order by updated_at desc nulls last
"""

CREATOR_GAPS = """
select c.id, c.title, count(distinct s.id) as recent_sources
from nodes c
join edges e on e.dst = c.id
join nodes s on s.id = e.src and s.type = 'summary'
where c.type = 'concept'
  and coalesce(s.updated_at, s.synced_at) >= now() - interval '14 days'
  and not exists (
    select 1 from edges ei join nodes i on i.id = ei.src and i.type = 'idea'
    where ei.dst = c.id
  )
group by c.id, c.title having count(distinct s.id) >= 3
order by recent_sources desc
"""

CREATOR_COMPETITORS = """
select title, props->>'url' as url, updated_at from nodes
where type = 'entity' and props->'tags' @> '["competitor"]'::jsonb
order by updated_at desc nulls last
"""


def creator_stats(conn):
    gaps = [{"id": str(r["id"]), "title": r["title"], "recent_sources": r["recent_sources"]}
            for r in conn.execute(CREATOR_GAPS).fetchall()]
    pipeline = [{"title": r["title"], "status": r["status"], "hook": r["hook"]}
                for r in conn.execute(CREATOR_PIPELINE).fetchall()]
    competitors = [{"title": r["title"], "url": r["url"]}
                   for r in conn.execute(CREATOR_COMPETITORS).fetchall()]
    return {"trend_gaps": gaps, "pipeline": pipeline, "competitors": competitors}
