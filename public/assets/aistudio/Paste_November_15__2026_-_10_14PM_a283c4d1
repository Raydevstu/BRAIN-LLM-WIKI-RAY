```python
from contextlib import asynccontextmanager

from fastapi import FastAPI, HTTPException, Query
from fastapi.middleware.cors import CORSMiddleware

from . import config, db
from .embeddings import default_embedder
from .retrieval import creator_stats, ego_graph, hybrid_search, node_detail, pick_center


@asynccontextmanager
async def lifespan(app):
    db.pool()
    yield


app = FastAPI(title="CortexOS", version="0.1.0", lifespan=lifespan)
app.add_middleware(CORSMiddleware, allow_origins=config.CORS_ORIGINS,
                   allow_methods=["*"], allow_headers=["*"])


@app.get("/health")
def health():
    with db.pool().connection() as conn:
        counts = {t: conn.execute(f"select count(*) as c from {t}").fetchone()["c"]
                  for t in ("nodes", "edges", "chunks")}
    return {"ok": True, **counts}


@app.get("/search")
def search(q: str = Query(min_length=1), limit: int = Query(default=10, ge=1, le=50)):
    with db.pool().connection() as conn:
        return hybrid_search(conn, q, limit, default_embedder())


@app.get("/nodes/{node_id}")
def get_node(node_id: str):
    with db.pool().connection() as conn:
        detail = node_detail(conn, node_id)
    if detail is None:
        raise HTTPException(404, "node not found")
    return detail


@app.get("/graph/ego")
def graph_ego(node_id: str | None = None, q: str | None = None,
              hops: int = Query(default=2, ge=1, le=3)):
    with db.pool().connection() as conn:
        center = node_id
        if center is None and q:
            hits = hybrid_search(conn, q, 1, default_embedder())
            center = hits[0]["id"] if hits else None
        if center is None:
            center = pick_center(conn)
        if center is None:
            return {"nodes": [], "edges": []}
        return ego_graph(conn, center, hops)


@app.get("/stats/creator")
def stats_creator():
    with db.pool().connection() as conn:
        return creator_stats(conn)
