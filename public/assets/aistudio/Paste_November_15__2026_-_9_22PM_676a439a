"use client";

import React, { useEffect, useState } from "react";
import { Search, X, Sparkles } from "lucide-react";
import type { GraphSearchResult } from "../types";
import { useGraph } from "../hooks/useGraph";

export function GraphSearch() {
  const { searchQuery, setSearchQuery, searchServer, setSelectedNodeId } = useGraph();
  const [serverHits, setServerHits] = useState<GraphSearchResult[]>([]);
  const [open, setOpen] = useState(false);

  useEffect(() => {
    const q = searchQuery.trim();
    if (q.length < 2) {
      setServerHits([]);
      return;
    }
    let active = true;
    const timer = setTimeout(() => {
      searchServer(q, 8)
        .then((hits) => {
          if (active) setServerHits(hits);
        })
        .catch(() => {
          if (active) setServerHits([]);
        });
    }, 240);
    return () => {
      active = false;
      clearTimeout(timer);
    };
  }, [searchQuery, searchServer]);

  return (
    <div className="relative w-64 sm:w-80">
      <div className="flex items-center gap-2 rounded-md border border-slate-700/70 bg-slate-900/90 px-2.5 py-1.5 text-xs text-slate-100 backdrop-blur-md">
        <Search className="h-3.5 w-3.5 shrink-0 text-slate-400" />
        <input
          type="text"
          value={searchQuery}
          onFocus={() => setOpen(true)}
          onChange={(e) => {
            setSearchQuery(e.target.value);
            setOpen(true);
          }}
          placeholder="Filter or hybrid-search graph..."
          className="w-full bg-transparent text-xs text-slate-100 placeholder-slate-500 focus:outline-none"
        />
        {searchQuery && (
          <button
            type="button"
            onClick={() => {
              setSearchQuery("");
              setServerHits([]);
            }}
            className="text-slate-400 hover:text-white"
          >
            <X className="h-3.5 w-3.5" />
          </button>
        )}
      </div>

      {open && serverHits.length > 0 && (
        <div className="ge-scrollbar absolute left-0 right-0 top-full z-40 mt-1.5 max-h-72 overflow-y-auto rounded-lg border border-slate-700/80 bg-slate-950/95 p-1.5 shadow-2xl backdrop-blur-xl">
          <div className="mb-1 flex items-center gap-1 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider text-slate-400">
            <Sparkles className="h-3 w-3 text-sky-400" />
            <span>Hybrid FTS + Vector Hits</span>
          </div>
          {serverHits.map((hit) => (
            <button
              key={`${hit.nodeId}-${hit.title}`}
              type="button"
              onClick={() => {
                setSelectedNodeId(hit.nodeId);
