5. Provider & Canvas Setup
Import @cortex/graph-engine/styles.css in your root layout and mount <GraphProvider> + <GraphCanvas> in any client page:
Tsx
"use client";

import "@cortex/graph-engine/styles.css";
import { GraphProvider, GraphCanvas } from "@cortex/graph-engine";

export default function KnowledgeGraphPage() {
  return (
    <div className="h-screen w-screen">
      <GraphProvider apiBasePath="/api/graph" initialLayout="orbit" initialTheme="obsidian">
        <GraphCanvas />
      </GraphProvider>
    </div>
  );
}
