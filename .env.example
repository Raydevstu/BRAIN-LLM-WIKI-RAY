# GEMINI_API_KEY: Required for Gemini AI embeddings and knowledge linking.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL 15+ connection string with pgvector.
# Leave empty to run zero-config persistent local PostgreSQL via PGlite.
DATABASE_URL=""

# GRAPH_PGDATA_DIR: Optional directory path for local PGlite storage.
GRAPH_PGDATA_DIR=".graph-engine/pgdata"

# GRAPH_API_KEY: Optional Bearer/x-api-key secret when enabling route auth guards.
GRAPH_API_KEY=""
